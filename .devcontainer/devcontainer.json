{
    "image": "tensorflow/tensorflow:2.14.0-gpu-jupyter",
    "hostRequirements": {
        "cpus": 4
    },
    "waitFor": "onCreateCommand",
    "updateContentCommand": "python3 -m pip install fastapi obspy pandas pydantic scikit-learn scipy tqdm",
    "postCreateCommand": "",
    "customizations": {
        "codespaces": {
            "openFiles": []
        },
        "vscode": {
            "extensions": [
                "ms-toolsai.jupyter",
                "ms-python.python"
            ]
        }
    },
    "name": "PhaseNet",
    "runArgs": [
        "-it",
        "--gpus",
        "all"
    ],
    "shutdownAction": "none"
}